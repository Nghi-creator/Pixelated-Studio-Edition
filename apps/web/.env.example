VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=
VITE_API_URL=http://127.0.0.1:4000
VITE_TURNSTILE_SITE_KEY=
VITE_USER_EDITION_ORIGIN=http://localhost:5174

# Optional N4 tracing; disabled by default. See docs/n4-browser-stage-tracing.md.
VITE_N4_STAGE_TRACE=0
VITE_N4_STAGE_TRACE_EVERY_NTH_FRAME=1
VITE_N4_STAGE_TRACE_MAX_FRAMES=2000
VITE_N4_STAGE_TRACE_MAX_EVENTS=10000
# Required for export when enabled: the deployed producer lowercase 40-hex commit.
VITE_N4_STAGE_TRACE_PRODUCER_VERSION=
