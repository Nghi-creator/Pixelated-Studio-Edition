ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
ARG NATIVE_RUNTIME_ID=debian-native-v1
ARG NATIVE_RUNTIME_LOCK_SHA256=unknown
ARG NODE_IMAGE=node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7

FROM ${NODE_IMAGE} AS app-builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY server.ts tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM ${DEBIAN_IMAGE} AS python-builder

ENV DEBIAN_FRONTEND=noninteractive

COPY python-requirements.lock /tmp/python-requirements.lock

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    && pip3 install --break-system-packages --no-cache-dir --target /out -r /tmp/python-requirements.lock \
    && rm -rf /var/lib/apt/lists/*

FROM ${DEBIAN_IMAGE} AS runtime

ARG TARGETARCH
ARG NATIVE_RUNTIME_ID=debian-native-v1
ARG NATIVE_RUNTIME_LOCK_SHA256=unknown
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/usr/local/lib/pixelated-python
LABEL com.pixelated.runtime.kind="native_linux" \
      com.pixelated.runtime.id="${NATIVE_RUNTIME_ID}" \
      com.pixelated.runtime.lock_sha256="${NATIVE_RUNTIME_LOCK_SHA256}"

# Debian binNMU revisions are architecture-specific even when their source
# package version is identical. Keep both supported binary revisions explicit.
RUN case "${TARGETARCH}" in \
      amd64) neverball_version='1.6.0+git20180603-3+b1' ;; \
      arm64) neverball_version='1.6.0+git20180603-3+b2' ;; \
      *) printf 'Unsupported native runtime architecture: %s\n' "${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && apt-get update && apt-get install -y --no-install-recommends \
    frozen-bubble=2.212-13+b1 \
    gir1.2-gst-plugins-bad-1.0 \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-nice \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-pulseaudio \
    gstreamer1.0-tools \
    "neverball=${neverball_version}" \
    pulseaudio \
    python3 \
    python3-evdev \
    python3-gi \
    python3-gst-1.0 \
    libxtst6 \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --user-group pixelated \
    && usermod -aG pulse-access pixelated \
    && mkdir -p /app /roms /run/pixelated \
    && chown -R 10001:10001 /roms /run/pixelated /home/pixelated \
    && chmod 0700 /run/pixelated

COPY --from=app-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=app-builder /app/dist /app/dist
COPY --from=app-builder /app/node_modules /app/node_modules
COPY --from=python-builder /out /usr/local/lib/pixelated-python
COPY camera.py camera_config.py camera_protocol.py camera_state.py input_gamepad.py input_keyboard.py /app/
COPY native-runtime.lock.json /app/native-runtime.lock.json

WORKDIR /app
ENV HOME=/home/pixelated
USER 10001:10001

CMD ["node", "dist/server.js"]
