{
  "name": "@pixelated/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check:access-log-schema": "tsx scripts/stagingSmoke.ts --access-log-schema-only",
    "check:catalog-rpc": "tsx scripts/stagingSmoke.ts --catalog-rpc-only",
    "check:catalog-candidate-imports": "tsx scripts/checkCatalogCandidateImportValidation.ts",
    "check:submission-cleanup-policy": "tsx scripts/stagingSmoke.ts --submission-cleanup-policy-only",
    "capture:catalog-artwork": "tsx scripts/captureCatalogArtwork.ts",
    "generate:curated-rom-manifest": "tsx scripts/generateCuratedRomManifest.ts",
    "import:debian-native-candidates": "tsx scripts/importDebianNativeCandidates.ts",
    "import:curated-rom-candidates": "tsx scripts/importCuratedRomCandidates.ts",
    "import:homebrew-candidates": "tsx scripts/importHomebrewHubCandidates.ts",
    "lint": "eslint .",
    "mirror:catalog-artifacts": "tsx scripts/mirrorCatalogArtifacts.ts",
    "predeploy:hosted": "node scripts/hostedPredeploy.mjs",
    "smoke:staging": "tsx scripts/stagingSmoke.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "upload:catalog-artwork-overrides": "tsx scripts/uploadCatalogArtworkOverrides.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.13",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  }
}
